{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["github-actions", "dockerfile", "custom.regex"],
  "schedule": ["* 9 * * 1,3,5"],
  "timezone": "Etc/UTC",
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Update Dashboard",
  "dependencyDashboardHeader": "Tracks GitHub Actions and container image updates. Pending age checks are intentional; no updates are auto-merged.",
  "dependencyDashboardFooter": "Dex uses GHCR, which does not expose a release timestamp Renovate can verify. See the Dependency updates available issue for upstream Dex releases; image digest age still requires manual review.",
  "ignoreUnstable": true,
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Workflows must pin full semver (v4.4.0), not floating majors (v4)",
      "matchManagers": ["github-actions"],
      "matchCurrentVersion": "/^v\\d+$/",
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Official python image tags use PEP 440; default docker versioning misses patch bumps on -slim",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "versioning": "pep440",
      "allowedVersions": "<3.15"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "eligible GitHub Actions"
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "eligible container images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^e2e/scripts/(emulator|dex)\\.sh$/"],
      "matchStrings": [
        "(?<prefix>(?:EMULATOR_IMAGE|DEX_IMAGE)=\"\\$\\{(?:EMULATOR_IMAGE|DEX_IMAGE):-)(?<depName>[^:}]+):(?<currentValue>[^@}]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?(?<suffix>\\}\")"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
